# Qode environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# ---------------------------------------------------------------------------

# Gemini (default provider — free tier: 15 RPM, 1M TPM)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional alternative provider)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (local, no API key required — set base URL if non-default)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Qode Configuration Overrides
# ---------------------------------------------------------------------------

# Default LLM model (format: provider/model)
# QODE_DEFAULT_MODEL=gemini/gemini-2.0-flash

# Web server port
# QODE_SERVER_PORT=3000

# Database directory (where KuzuDB stores its files)
# QODE_DB_DIR=.qode_db
